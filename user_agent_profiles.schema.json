{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apexai.local/schemas/user-agent-profiles-v1.schema.json",
  "title": "Apex User-Agent Profile Document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metadata", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "metadata": {
      "type": "object"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["user_agent", "weight"],
        "properties": {
          "user_agent": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[\\x20-\\x7E]+$"
          },
          "weight": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}
